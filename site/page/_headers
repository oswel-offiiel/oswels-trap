# Réglages lus par Netlify (en-têtes envoyés avec chaque fichier)

# Pour tout le site : sécurité de base
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# La page de téléchargement : elle ne peut parler qu'à elle-même et à l'API de GitHub
# (pas appliqué au jeu dans jouer/, qui a besoin de plus de liberté)
/
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data:; media-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
/index.html
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data:; media-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# Mise en cache longue des polices, images et vidéo de la page
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/video/*
  Cache-Control: public, max-age=604800

# Le jeu dans le navigateur (jouer/)
# - sw.js toujours relu : c'est lui qui annonce une nouvelle version du jeu aux joueurs
# - les voix ne changent pas d'une visite à l'autre : on les garde une semaine
/jouer/sw.js
  Cache-Control: no-cache
/jouer/audio/*
  Cache-Control: public, max-age=604800
